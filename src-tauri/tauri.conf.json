{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Codex Themes",
  "version": "0.1.5",
  "identifier": "com.codexthemes.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Themes",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Library/Application Support/CodexDreamSkinStudio/themes/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "fileAssociations": [
      {
        "ext": ["codextheme"],
        "name": "Codex Theme",
        "description": "Cross-platform Codex Themes package",
        "role": "Editor",
        "mimeType": "application/vnd.codexthemes.theme"
      }
    ],
    "resources": {
      ".bundle-resources/macos-engine/assets/": "macos-engine/assets/",
      ".bundle-resources/macos-engine/scripts/": "macos-engine/scripts/",
      ".bundle-resources/macos-engine/presets/": "macos-engine/presets/",
      ".bundle-resources/macos-engine/VERSION": "macos-engine/VERSION"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "../resources/dmg/install-guide-bilingual.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 143,
          "y": 160
        },
        "applicationFolderPosition": {
          "x": 516,
          "y": 160
        }
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
